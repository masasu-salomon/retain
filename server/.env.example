# PostgreSQL connection string (local docker-compose DB shown; use your Neon URL in production)
DATABASE_URL="postgresql://retain:retain@localhost:5436/retain?schema=public"
# Long random string used to sign JWTs
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN="http://localhost:5173"
# Admin account created by `npm run db:seed`
ADMIN_NAME="Retain Admin"
ADMIN_EMAIL="admin@retain.app"
ADMIN_PASSWORD="Admin@12345"
# Set to "true" to also seed a demo user with sample expenses
SEED_DEMO_DATA="true"
